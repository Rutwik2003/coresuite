# =====================================================================================
#  PlaytimeReward - Core System
#  File: playtimereward.sk
#  Requires: Skript 2.15.4+, SkBee 3.25.1+ (needs SkBee's Statistic expression,
#            present since SkBee 1.17.0), Vault
#  Server: Paper 26.1.2
# =====================================================================================
#
#  DATA STORAGE: native Skript variables (UUID-keyed), persisted automatically by
#  Skript's variable storage. No custom save-loop is needed for that reason - Skript
#  flushes variables on its own configured interval.
#
#  TIME SOURCE (v3 - AFK-filtered): playtime is read live from Minecraft's own
#  vanilla "play_one_minute" statistic via SkBee (in ticks -> /20 for seconds), which
#  every server already tracks per-player, persisted forever, survives restarts, and
#  needs zero bookkeeping on our end for the RAW number.
#
#  However that raw stat counts AFK time too. To filter AFK back out without paying
#  for a full custom playtime-tracking loop, this version runs a lightweight
#  per-second loop that does ONLY ONE THING: increments {ptr::afkseconds::%uuid%} for
#  each online player who is currently AFK. Effective playtime = raw vanilla seconds
#  minus accumulated AFK seconds minus admin adjustment offset, clamped at 0. This is
#  much cheaper than the old v1 loop (no per-player unlock-checking every second, no
#  writing the playtime variable every second - just one counter increment for idle
#  players).
#
#  KNOWN CAVEAT: if you run AuthMe (or similar) and freeze players pre-login, the
#  vanilla stat still ticks up from the moment their client fully joins the world,
#  not from the moment they finish authenticating. A few seconds of login-screen time
#  can count toward playtime unless they're also flagged AFK during that window
#  (unlikely, since no activity has happened yet - see the join handler below, which
#  starts them AFK-eligible immediately).
# =====================================================================================

options:
	ptr: ptr
	ptrPrefix: &8[&6&lPlaytime&e&lRewards&8] &r


# =====================================================================================
#  SCRIPT LOAD
# =====================================================================================

on script load:
	if {ptr::config::max-accounts-per-ip} is not set:
		set {ptr::config::max-accounts-per-ip} to 0
	if {ptr::config::claim-cooldown} is not set:
		set {ptr::config::claim-cooldown} to 3 seconds
	if {ptr::config::afk-timeout} is not set:
		set {ptr::config::afk-timeout} to 120
	if {ptr::config::debug} is not set:
		set {ptr::config::debug} to false
	if {ptr::config::system-enabled} is not set:
		set {ptr::config::system-enabled} to true
	if {ptr::config::gui-title} is not set:
		set {ptr::config::gui-title} to "&8&lPlaytime Rewards"
	if {ptr::config::rewards-per-page} is not set:
		set {ptr::config::rewards-per-page} to 21
	if {ptr::clock} is not set:
		set {ptr::clock} to 0

	delete {ptr::rewards::*}
	delete {ptr::reward-ids::*}
	_ptr_registerDefaultRewards()

	send "{@ptrPrefix}&aScript loaded. %size of {ptr::rewards::*}% rewards registered." to console
	_ptr_log("Script (re)loaded successfully.")


# =====================================================================================
#  DEFAULT REWARD REGISTRATION
# =====================================================================================

