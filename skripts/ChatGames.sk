function getOnlinePlayerCount() :: number:
    set {_count} to 0
    loop all players:
        add 1 to {_count}
    return {_count}

on load:
    loadChatGameConfig()

# ============ ADMIN COMMAND ============
command /chatgame [<text>] [<text>]:
    permission: chatgames.admin
    permission message: &cYou don't have permission to manage Chat Games.
    trigger:
        if argument 1 is not set:
            send "{@prefix} &7Usage: &f/chatgame <start|force|stop|toggle|reload|top|revealanswer> [option]"
            stop trigger

        if argument 1 is "reload":
            loadChatGameConfig()
            send "{@prefix} &aConfig and question pools reloaded."
            stop trigger

        if argument 1 is "toggle":
            if {cg.enabled} is true:
                set {cg.enabled} to false
                send "{@prefix} &cChat Games disabled."
            else:
                set {cg.enabled} to true
                send "{@prefix} &aChat Games enabled."
            stop trigger

        if argument 1 is "revealanswer":
            if argument 2 is "on":
                set {cg.revealanswer} to true
                send "{@prefix} &aAnswer reveal on timeout is now &lENABLED&r&a. The correct answer will be posted in chat if nobody answers in time."
            else if argument 2 is "off":
                set {cg.revealanswer} to false
                send "{@prefix} &cAnswer reveal on timeout is now &lDISABLED&r&c. The answer will stay hidden if nobody answers in time."
            else if argument 2 is set:
                send "{@prefix} &cUsage: &f/chatgame revealanswer <on|off>"
            else:
                if {cg.revealanswer} is true:
                    set {cg.revealanswer} to false
                    send "{@prefix} &cAnswer reveal on timeout toggled &lOFF&r&c."
                else:
                    set {cg.revealanswer} to true
                    send "{@prefix} &aAnswer reveal on timeout toggled &lON&r&a."
            stop trigger

        if argument 1 is "stop":
            if {cg.active} is not true:
                send "{@prefix} &cThere is no active game to stop."
                stop trigger
            set {cg.active} to false
            delete {cg.answer}
            delete {cg.difficulty}
            delete {cg.question}
            broadcast "{@prefix} &cThe current game was cancelled by an admin."
            stop trigger

        set {_cmd} to argument 1
        if {_cmd} is "force" or "start":
            if {cg.active} is true:
                send "{@prefix} &cA game is already active!"
                stop trigger
            if {_cmd} is "start":
                set {_online} to getOnlinePlayerCount()
                if {_online} < {cg.minplayers}:
                    send "{@prefix} &cNeed at least %{cg.minplayers}% players online to start a game. Use &f/chatgame force <difficulty> &cto override."
                    stop trigger
            if argument 2 is set:
                startChatGame(argument 2)
            else:
                startChatGame("random")
            stop trigger

        if argument 1 is "top":
            showChatGameLeaderboard(player)
            stop trigger

command /chatgametop:
    trigger:
        showChatGameLeaderboard(player)

# ============ AUTO SCHEDULER ============
every 5 minutes:
    if {cg.enabled} is not true:
        stop trigger
    if {cg.active} is true:
        stop trigger
    if {cg.timeuntilnext} is not set:
        set {cg.timeuntilnext} to random integer between {cg.mindelay} and {cg.maxdelay}
        stop trigger
    remove 300 from {cg.timeuntilnext}
    if {cg.timeuntilnext} <= 0:
        set {_online} to getOnlinePlayerCount()
        if {_online} < {cg.minplayers}:
            set {cg.timeuntilnext} to 300
            stop trigger
        delete {cg.timeuntilnext}
        startChatGame("random")

# ============ START A GAME ============
function startChatGame(diff: text):
    if {cg.enabled} is not true:
        stop

    set {_online} to getOnlinePlayerCount()
    if {_online} < {cg.minplayers}:
        stop

    if {_diff} is "random":
        set {_roll} to random integer between 1 and 100
        if {_roll} <= 35:
            set {_diff} to "easy"
        else if {_roll} <= 60:
            set {_diff} to "normal"
        else if {_roll} <= 78:
            set {_diff} to "intermediate"
        else if {_roll} <= 90:
            set {_diff} to "hard"
        else if {_roll} <= 97:
            set {_diff} to "difficult"
        else:
            set {_diff} to "extreme"

    # ---- pick a question type ----
    # trivia pool is capped lower and no-repeat filtered so regulars can't
    # just memorize the whole list; math/scramble/serverdata are always
    # freshly generated so there is nothing fixed to memorize there.
    set {_typeroll} to random integer between 1 and 100
    if {_typeroll} <= 35:
        # ---- trivia pool question (no-repeat filtered) ----
        if size of {cg.pool.%{_diff}%::*} is 0:
            stop
        set {_entry} to pickNonRepeatingTrivia({_diff})
    else if {_typeroll} <= 65:
        # ---- freshly generated math question ----
        set {_entry} to generateMathQuestion({_diff})
    else if {_typeroll} <= 85:
        # ---- freshly generated word scramble (no-repeat filtered) ----
        set {_entry} to generateScrambleQuestion({_diff})
    else:
        # ---- live server data question, answer changes every single game ----
        set {_entry} to generateServerDataQuestion({_diff})

    set {_q} to first element out of (split {_entry} at "|")
    set {_a} to last element out of (split {_entry} at "|")

    set {cg.active} to true
    set {cg.difficulty} to {_diff}
    set {cg.question} to {_q}
    set {cg.answer} to {_a}
    set {cg.starttime} to now

    set {_color} to difficultyColor({_diff})
    set {_label} to difficultyLabel({_diff})

    play sound "block.note_block.chime" with volume 1.5 and pitch 1.1 to all players

    broadcast ""
    broadcast "&8&m--------------------------------------------------"
    broadcast "              &6&l⭐ CHAT GAME ⭐"
    broadcast "        %{_color}%%{_label}% &7difficulty question!"
    broadcast ""
    broadcast "  &f❓ %{_q}%"
    broadcast ""
    broadcast "  &7Type your answer in chat! &e(%{cg.answertime}%s to answer)"
    broadcast "&8&m--------------------------------------------------"
    broadcast ""

    loop {cg.answertime} times:
        wait 1 second
        if {cg.active} is not true:
            stop loop
    if {cg.active} is true:
        if {cg.revealanswer} is true:
            broadcast "{@prefix} &cTime's up! Nobody answered correctly."
            broadcast "&7The answer was: &f%{cg.firstanswer}%"
        else:
            broadcast "{@prefix} &cTime's up! Nobody answered correctly."
        set {cg.active} to false
        delete {cg.answer}
        delete {cg.firstanswer}
        delete {cg.difficulty}
        delete {cg.question}

function difficultyColor(diff: text) :: text:
    if {_diff} is "easy":
        set {_r} to "&a"
    else if {_diff} is "normal":
        set {_r} to "&2"
    else if {_diff} is "intermediate":
        set {_r} to "&e"
    else if {_diff} is "hard":
        set {_r} to "&6"
    else if {_diff} is "difficult":
        set {_r} to "&c"
    else:
        set {_r} to "&4&l"
    return {_r}

function difficultyLabel(diff: text) :: text:
    if {_diff} is "easy":
        set {_r} to "Easy"
    else if {_diff} is "normal":
        set {_r} to "Normal"
    else if {_diff} is "intermediate":
        set {_r} to "Intermediate"
    else if {_diff} is "hard":
        set {_r} to "Hard"
    else if {_diff} is "difficult":
        set {_r} to "Difficult"
    else:
        set {_r} to "EXTREME"
    return {_r}

# ============ NO-REPEAT TRIVIA PICKER ============
# Picks a random trivia entry from the given difficulty pool, re-rolling
# (up to 12 tries) if it was one of the last {cg.norepeat.size} questions
# asked. Keeps a rolling history in {cg.recentq::*} keyed by an
# ever-increasing counter so we can always drop the oldest entry.
function pickNonRepeatingTrivia(diff: text) :: text:
    set {_pool::*} to {cg.pool.%{_diff}%::*}
    set {_entry} to a random element out of {_pool::*}
    set {_tries} to 0
    while {_tries} < 12:
        set {_isrecent} to false
        loop {cg.recentq::*}:
            if loop-value is {_entry}:
                set {_isrecent} to true
        if {_isrecent} is false:
            stop loop
        set {_entry} to a random element out of {_pool::*}
        add 1 to {_tries}

    if {cg.recentq.counter} is not set:
        set {cg.recentq.counter} to 0
    add 1 to {cg.recentq.counter}
    set {cg.recentq::%{cg.recentq.counter}%} to {_entry}
    set {_old} to {cg.recentq.counter} - {cg.norepeat.size}
    if {_old} >= 1:
        delete {cg.recentq::%{_old}%}

    return {_entry}

# ============ DYNAMIC MATH GENERATOR ============
# Numbers are rolled fresh every single call, the answer is computed live
# right here in Skript (never hardcoded), scaling with difficulty tier.
function generateMathQuestion(diff: text) :: text:
    if {_diff} is "easy":
        set {_a} to random integer between 1 and 20
        set {_b} to random integer between 1 and 20
        set {_op} to random integer between 1 and 2
        if {_op} is 1:
            set {_ans} to {_a} + {_b}
            set {_q} to "%{_a}% + %{_b}% = ?"
        else:
            if {_a} < {_b}:
                set {_temp} to {_a}
                set {_a} to {_b}
                set {_b} to {_temp}
            set {_ans} to {_a} - {_b}
            set {_q} to "%{_a}% - %{_b}% = ?"

    else if {_diff} is "normal":
        set {_b} to random integer between 2 and 12
        set {_op} to random integer between 1 and 2
        if {_op} is 1:
            set {_a} to random integer between 2 and 12
            set {_ans} to {_a} * {_b}
            set {_q} to "%{_a}% * %{_b}% = ?"
        else:
            set {_ans} to random integer between 2 and 12
            set {_product} to {_ans} * {_b}
            set {_q} to "%{_product}% / %{_b}% = ?"

    else if {_diff} is "intermediate":
        set {_a} to random integer between 2 and 15
        set {_b} to random integer between 2 and 15
        set {_c} to random integer between 2 and 15
        set {_op} to random integer between 1 and 2
        if {_op} is 1:
            set {_ans} to ({_a} * {_b}) + {_c}
            set {_q} to "%{_a}% * %{_b}% + %{_c}% = ?"
        else:
            set {_ans} to {_a} + ({_b} * {_c})
            set {_q} to "%{_a}% + %{_b}% * %{_c}% = ?"

    else if {_diff} is "hard":
        set {_a} to random integer between 5 and 25
        set {_b} to random integer between 2 and 15
        set {_c} to random integer between 5 and 25
        set {_d} to random integer between 2 and 15
        set {_ans} to ({_a} * {_b}) - ({_c} * {_d})
        if {_ans} < 0:
            set {_e} to {_a}
            set {_a} to {_c}
            set {_c} to {_e}
            set {_e} to {_b}
            set {_b} to {_d}
            set {_d} to {_e}
            set {_ans} to ({_a} * {_b}) - ({_c} * {_d})
        set {_q} to "(%{_a}% * %{_b}%) - (%{_c}% * %{_d}%) = ?"

    else if {_diff} is "difficult":
        set {_a} to random integer between 10 and 40
        set {_b} to random integer between 10 and 40
        set {_c} to random integer between 2 and 20
        set {_ans} to (({_a} + {_b}) * {_c}) - {_a}
        set {_q} to "(%{_a}% + %{_b}%) * %{_c}% - %{_a}% = ?"

    else:
        # Extreme
        set {_a} to random integer between 15 and 45
        set {_b} to random integer between 15 and 45
        if {_a} < {_b}:
            set {_e} to {_a}
            set {_a} to {_b}
            set {_b} to {_e}
        set {_ans} to ({_a} * {_a}) - ({_b} * {_b})
        set {_q} to "(%{_a}% * %{_a}%) - (%{_b}% * %{_b}%) = ?"

    return "%{_q}%|%{_ans}%"

# ============ WORD SCRAMBLE GENERATOR (no-repeat filtered) ============
function generateScrambleQuestion(diff: text) :: text:
    if {_diff} is "easy":
        set {_pool::*} to {cg.words.easy::*}
    else if {_diff} is "normal":
        set {_pool::*} to {cg.words.normal::*}
    else if {_diff} is "intermediate":
        set {_pool::*} to {cg.words.intermediate::*}
    else if {_diff} is "hard":
        set {_pool::*} to {cg.words.hard::*}
    else if {_diff} is "difficult":
        set {_pool::*} to {cg.words.difficult::*}
    else:
        set {_pool::*} to {cg.words.extreme::*}

    set {_word} to a random element out of {_pool::*}
    set {_tries} to 0
    while {_tries} < 12:
        set {_isrecent} to false
        loop {cg.recentwords::*}:
            if loop-value is {_word}:
                set {_isrecent} to true
        if {_isrecent} is false:
            stop loop
        set {_word} to a random element out of {_pool::*}
        add 1 to {_tries}

    if {cg.recentwords.counter} is not set:
        set {cg.recentwords.counter} to 0
    add 1 to {cg.recentwords.counter}
    set {cg.recentwords::%{cg.recentwords.counter}%} to {_word}
    set {_old} to {cg.recentwords.counter} - {cg.norepeat.size}
    if {_old} >= 1:
        delete {cg.recentwords::%{_old}%}

    set {_scrambled} to shuffleWord({_word})
    loop 5 times:
        if {_scrambled} is not "%{_word}%":
            stop loop
        set {_scrambled} to shuffleWord({_word})

    set {_display} to ""
    set {_slen} to length of {_scrambled}
    loop {_slen} times:
        set {_ch} to charAt({_scrambled}, loop-number)
        set {_display} to "%{_display}%%{_ch}% "

    return "Unscramble this word: %{_display}%|%{_word}%"

# ============ LIVE SERVER DATA GENERATOR ============
# These answers depend on the exact moment the question is generated,
# so there is nothing fixed for players to memorize ahead of time.
function generateServerDataQuestion(diff: text) :: text:
    set {_roll} to random integer between 1 and 2
    if {_roll} is 1:
        set {_count} to getOnlinePlayerCount()
        return "How many players are online on the server right at this moment?|%{_count}%"
    else:
        set {_count} to getOnlinePlayerCount()
        set {_next} to {_count} + 1
        return "%{_count}% players are online right now. If one more player joined, how many would that be?|%{_next}%"

# ---- gets the character at position i of a string using only vanilla Skript ----
function charAt(w: text, i: number) :: text:
    set {_first} to first {_i} characters of {_w}
    set {_last} to last 1 characters of {_first}
    return {_last}

# ---- Fisher-Yates shuffle of a word's letters (fresh every call) ----
function shuffleWord(w: text) :: text:
    delete {_c::*}
    set {_len} to length of {_w}
    loop {_len} times:
        set {_ch} to charAt({_w}, loop-number)
        add {_ch} to {_c::*}

    loop {_len} times:
        set {_i} to loop-number
        set {_j} to random integer between 1 and {_len}
        set {_temp} to {_c::%{_i}%}
        set {_c::%{_i}%} to {_c::%{_j}%}
        set {_c::%{_j}%} to {_temp}

    set {_result} to ""
    loop {_len} times:
        set {_result} to "%{_result}%%{_c::%loop-number%}%"
    delete {_c::*}
    return {_result}

# ============ ANSWER DETECTION ============
# {cg.answer} can now be a comma-separated alias list, e.g. "axe,wood axe".
# We keep {cg.firstanswer} (the first alias) around purely so the timeout
# reveal message shows one clean answer instead of the whole alias list.
on chat:
    if {cg.active} is not true:
        stop trigger
    if {cg.answer} is not set:
        stop trigger

    if {cg.firstanswer} is not set:
        set {cg.firstanswer} to first element out of (split {cg.answer} at ",")

    set {_msg} to message
    set {_correct} to false
    loop (split {cg.answer} at ","):
        if {_msg} is loop-value:
            set {_correct} to true

    if {_correct} is true:
        set {cg.active} to false
        cancel event
        set {_diff} to {cg.difficulty}
        set {_winner} to player
        set {_shownanswer} to {cg.firstanswer}

        # leaderboard stat tracking
        add 1 to {cg.stats.%{_winner}'s uuid%}
        set {cg.statsname.%{_winner}'s uuid%} to "%{_winner}%"

        broadcast ""
        broadcast "&8&m--------------------------------------------------"
        broadcast "  &a&l✔ CORRECT! &f%{_winner}% &7answered first!"
        broadcast "  &7Answer: &f%{_shownanswer}%"
        rewardChatGameWinner({_winner}, {_diff})
        broadcast "&8&m--------------------------------------------------"
        broadcast ""

        delete {cg.answer}
        delete {cg.firstanswer}
        delete {cg.difficulty}
        delete {cg.question}

# ============ REWARD LOGIC ============
function rewardChatGameWinner(p: player, diff: text):
    set {_roll} to random integer between 1 and 100
    set {_itemRoll} to random integer between 1 and 100

    if {_diff} is "easy":
        set {_eco} to random integer between 500 and 1000
        execute console command "eco give %{_p}% %{_eco}%"
        broadcast " &6+ %{_eco}% coins &7rewarded to %{_p}%"

        if {_itemRoll} <= 40:
            give 4 iron ingot to {_p}
            broadcast " &f+ 4 Iron Ingots"
        else if {_itemRoll} <= 70:
            give 2 gold ingot to {_p}
            broadcast " &e+ 2 Gold Ingots"

    else if {_diff} is "normal":
        set {_eco} to random integer between 1000 and 2000
        execute console command "eco give %{_p}% %{_eco}%"
        broadcast " &6+ %{_eco}% coins &7rewarded to %{_p}%"

        if {_itemRoll} <= 40:
            give 6 gold ingot to {_p}
            broadcast " &e+ 6 Gold Ingots"
        else if {_itemRoll} <= 75:
            give 3 diamond to {_p}
            broadcast " &b+ 3 Diamonds"

    else if {_diff} is "intermediate":
        set {_eco} to random integer between 2000 and 3500
        execute console command "eco give %{_p}% %{_eco}%"
        broadcast " &6+ %{_eco}% coins &7rewarded to %{_p}%"

        if {_itemRoll} <= 50:
            give 5 diamond to {_p}
            broadcast " &b+ 5 Diamonds"
        else:
            give 1 emerald block to {_p}
            broadcast " &a+ 1 Emerald Block"

        if {_roll} <= 10:
            execute console command "crate key give %{_p}% common 1"
            broadcast " &b+ 1 Common Key"

    else if {_diff} is "hard":
        set {_eco} to random integer between 3500 and 6000
        execute console command "eco give %{_p}% %{_eco}%"
        broadcast " &6+ %{_eco}% coins &7rewarded to %{_p}%"

        if {_itemRoll} <= 50:
            give 8 diamond to {_p}
            broadcast " &b+ 8 Diamonds"
        else:
            give 3 golden apple to {_p}        # Changed to normal Golden Apple
            broadcast " &e+ 3 Golden Apples"

        if {_roll} <= 60:
            execute console command "crate key give %{_p}% common 1"
            broadcast " &b+ 1 Common Key"
        else:
            execute console command "crate key give %{_p}% uncommon 1"
            broadcast " &a+ 1 Uncommon Key"

    else if {_diff} is "difficult":
        set {_eco} to random integer between 6000 and 10000
        execute console command "eco give %{_p}% %{_eco}%"
        broadcast " &6+ %{_eco}% coins &7rewarded to %{_p}%"

        if {_itemRoll} <= 50:
            give 12 diamond to {_p}
            broadcast " &b+ 12 Diamonds"
        else:
            give 2 emerald block to {_p}
            broadcast " &a+ 2 Emerald Blocks"

        if {_roll} <= 50:
            execute console command "crate key give %{_p}% common 1"
            broadcast " &b+ 1 Common Key"
        else:
            execute console command "crate key give %{_p}% uncommon 1"
            broadcast " &a+ 1 Uncommon Key"

    else:
        # Extreme
        set {_eco} to random integer between 10000 and 20000
        execute console command "eco give %{_p}% %{_eco}%"
        broadcast " &6+ %{_eco}% coins &7rewarded to %{_p}%"

        give 16 diamond to {_p}
        broadcast " &b+ 16 Diamonds"
        give 6 golden apple to {_p}           # Changed to normal Golden Apple
        broadcast " &e&l+ 6 Golden Apples"

        if {_roll} <= 60:
            execute console command "crate key give %{_p}% uncommon 1"
            broadcast " &a+ 1 Uncommon Key"
        else:
            execute console command "crate key give %{_p}% common 1"
            broadcast " &b+ 1 Common Key"

# ============ LEADERBOARD ============
function showChatGameLeaderboard(viewer: player):
    if {cg.stats::*} is not set:
        send "{@prefix} &7No one has won a chat game yet." to {_viewer}
        stop

    delete {_ids::*}
    delete {_scores::*}
    loop {cg.stats::*}:
        add loop-index to {_ids::*}
        add loop-value to {_scores::*}

    set {_size} to size of {_scores::*}
    set {_limit} to 10
    if {_size} < 10:
        set {_limit} to {_size}

    send "&8&m--------------------------------------------------" to {_viewer}
    send "        &6&l🏆 CHAT GAMES LEADERBOARD 🏆" to {_viewer}
    send "" to {_viewer}

    # partial selection: only find the top {_limit} entries instead of sorting the whole list
    loop {_limit} times:
        set {_rank} to loop-number-1
        set {_bestindex} to 1
        set {_bestscore} to {_scores::1}
        loop {_size} times:
            if {_scores::%loop-number-2%} > {_bestscore}:
                set {_bestscore} to {_scores::%loop-number-2%}
                set {_bestindex} to loop-number-2

        set {_name} to {cg.statsname.%{_ids::%{_bestindex}%}%}

        if {_rank} is 1:
            send "  &6&l#1 &f%{_name}% &7- &e%{_bestscore}% wins" to {_viewer}
        else if {_rank} is 2:
            send "  &7&l#2 &f%{_name}% &7- &e%{_bestscore}% wins" to {_viewer}
        else if {_rank} is 3:
            send "  &c&l#3 &f%{_name}% &7- &e%{_bestscore}% wins" to {_viewer}
        else:
            send "  &f#%{_rank}% &f%{_name}% &7- &e%{_bestscore}% wins" to {_viewer}

        # remove this entry from further consideration
        set {_scores::%{_bestindex}%} to -1

    send "&8&m--------------------------------------------------" to {_viewer}
