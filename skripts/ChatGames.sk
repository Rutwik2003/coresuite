########################################################
# CHAT GAMES - Full Tiered Trivia/Question System
# Difficulties: Easy, Normal, Intermediate, Hard, Difficult, Extreme
# Question Types: Trivia Pool | Dynamic Math | Word Scramble | Live Server Data
# Rewards: Economy + Items + Crate Keys (scaling with difficulty)
# Includes: auto scheduler, min player check, leaderboard, admin commands
#
# CHANGELOG (this revision):
#  - No-repeat memory for trivia questions AND scramble words so regulars
#    stop seeing the same Q&A on loop (math is already fresh every time).
#  - New "live server data" question type - answer depends on the exact
#    moment the question fires, so it can never be memorized in advance.
#  - Trivia answers can now be a comma separated list of accepted aliases,
#    e.g. "iron pickaxe,pickaxe" so near-misses still count.
#  - /chatgame revealanswer <on|off> admin toggle - controls whether the
#    correct answer gets posted in chat when nobody answers in time.
########################################################

options:
    prefix: &8[&6&lChat Games&8]&r

# ============ CONFIG / LOAD ============
function loadChatGameConfig():
    set {cg.enabled} to true
    set {cg.active} to false

    # whether the answer gets revealed in chat if time runs out with no winner
    if {cg.revealanswer} is not set:
        set {cg.revealanswer} to true

    # delay between games (seconds) once one ends
    set {cg.mindelay} to 300
    set {cg.maxdelay} to 600

    # time players have to answer (seconds)
    set {cg.answertime} to 45

    # minimum players online required for a chat game to start
    set {cg.minplayers} to 2

    # how many recent trivia questions / scramble words to remember
    # and avoid repeating
    set {cg.norepeat.size} to 15

    # ---------- QUESTION POOLS (Question|Answer[,alias2,alias3]) ----------
    delete {cg.pool.easy::*}
    add "What block explodes when lit?|tnt" to {cg.pool.easy::*}
    add "What mob explodes near players?|creeper" to {cg.pool.easy::*}
    add "What do you mine diamonds with?|iron pickaxe,pickaxe" to {cg.pool.easy::*}
    add "What animal gives you wool?|sheep" to {cg.pool.easy::*}
